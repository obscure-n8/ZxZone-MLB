# ============================================
# ZxZone-MLB Bot Configuration
# ============================================

# Telegram API (Required)
BOT_TOKEN = ""
API_ID = 0
API_HASH = ""

# Owner & Admins
OWNER_ID = 
SUDO_USERS = 
AUTHORIZED_CHATS = ""
CMD_SUFFIX = ""
# Channels & Links
UPDATE_CHANNEL = ""
REPO_LINK = "https://github.com/obscure-n8/ZxZone-MLB"

# Database (Required)
DATABASE_URL = ""
REDIS_URL = redis://localhost:6379

# Aria2 Configuration
ARIA2_HOST = http://localhost
ARIA2_PORT = 6800
ARIA2_SECRET = your_aria2_secret

# Rclone Configuration
RCLONE_REMOTE = gdrive
RCLONE_CONFIG_PATH = config/rclone.conf

# Memory
MEM_BUDGET = 300

# Cpu Limit
CPU_LIMIT = 20

# CPUs given to FFmpeg. auto=60% of them, all/0=every CPU, a count like 5,
# a percentage like 75%, or an explicit taskset list like 0-4 / 0,1,2,3.
# Background services get whatever is left over.
FFMPEG_CORES = "auto"

# Throttle services during heavy ops (FFmpeg). auto=low-end only, always, never
THROTTLE_SERVICES = "auto"

# Bot Settings
MAX_TASKS_PER_USER = 3
MAX_TOTAL_TASKS = 50
QUEUE_LIMIT =
AS_DOCUMENT = False
ALLOW_PRIVATE_FILES = True
FORCE_SUBSCRIBE = True
STATUS_LIMIT = 6
# YT-DLP Settings
YTDLP_COOKIES_PATH = config/cookies.txt
MAX_VIDEO_HEIGHT = 1080

# GDrive Tools
GDRIVE_ID = ""
GD_DESP = "Uploaded with WZ Bot"
IS_TEAM_DRIVE = False
STOP_DUPLICATE = False
INDEX_URL = ""

# Telegraph
AUTHOR_NAME = "ZXZONE-MLB"
AUTHOR_URL = "https://github.com/obscure-n8/ZxZone-MLB"


# Optional
SPEEDTEST_INTERVAL = 30
LOG_CHANNEL = ""
DUMP_CHANNEL = ""

# Task Limits (0 = Unlimited)
DIRECT_LIMIT = 0
MEGA_LIMIT = 0
TORRENT_LIMIT = 0
GD_DL_LIMIT = 0
RC_DL_LIMIT = 0
CLONE_LIMIT = 0
JD_LIMIT = 0
NZB_LIMIT = 0
YTDLP_LIMIT = 0
PLAYLIST_LIMIT = 0
LEECH_LIMIT = 0
EXTRACT_LIMIT = 0
ARCHIVE_LIMIT = 0
