# ============================================
# ZxZone-MLB Bot Configuration
# ============================================

# Telegram API (Required)
BOT_TOKEN=your_bot_token_here
API_ID=your_api_id_here
API_HASH=your_api_hash_here
BOT_USERNAME=YourBotUsername

# Owner & Admins
OWNER_ID=your_telegram_id
SUDO_USERS=123456789 987654321

# Channels & Links
UPDATE_CHANNEL=https://t.me/zxzoneupdates
REPO_LINK=https://github.com/obscure-n8/ZxZone-MLB

# Database (Required)
DATABASE_URL=mongodb://localhost:27017/zxzone_mlb
REDIS_URL=redis://localhost:6379

# Aria2 Configuration
ARIA2_HOST=http://localhost
ARIA2_PORT=6800
ARIA2_SECRET=your_aria2_secret

# Rclone Configuration
RCLONE_REMOTE=gdrive
RCLONE_CONFIG_PATH=/app/config/rclone.conf

# Bot Settings
MAX_TASKS_PER_USER=3
MAX_TOTAL_TASKS=50
QUEUE_LIMIT=20
DEFAULT_UPLOAD_MODE=document
ALLOW_PRIVATE_FILES=True
FORCE_SUBSCRIBE=True

# YT-DLP Settings
YTDLP_COOKIES_PATH=/app/config/cookies.txt
MAX_VIDEO_HEIGHT=1080

# Optional
SPEEDTEST_INTERVAL=30
LOG_CHANNEL=-1001234567890
DUMP_CHANNEL=-1001234567890

# Task Limits (0 = Unlimited)
DIRECT_LIMIT=0
MEGA_LIMIT=0
TORRENT_LIMIT=0
GD_DL_LIMIT=0
RC_DL_LIMIT=0
CLONE_LIMIT=0
JD_LIMIT=0
NZB_LIMIT=0
YTDLP_LIMIT=0
PLAYLIST_LIMIT=0
LEECH_LIMIT=0
EXTRACT_LIMIT=0
ARCHIVE_LIMIT=0
STORAGE_LIMIT=0

# Disable Options (True/False)
DISABLE_TORRENTS=False
DISABLE_LEECH=False
DISABLE_MIRROR=False
DISABLE_BULK=False
DISABLE_MULTI=False
DISABLE_SEED=False
DISABLE_FF_MODE=False
DISABLE_JD=False
DISABLE_NZB=False
DISABLE_RSS=False
DISABLE_SEARCH=False
DISABLE_STREAM=False
DISABLE_YTDLP=False
DISABLE_MEGA=False

# Mega API
MEGA_EMAIL=
MEGA_PASSWORD=

# Queue System (0 = Unlimited)
QUEUE_ALL=0
QUEUE_DOWNLOAD=0
QUEUE_UPLOAD=0

# JDownloader
JD_EMAIL=
JD_PASS=

# Bot Settings
BOT_PM=False
SET_COMMANDS=True
TIMEZONE=Asia/Dhaka
FORCE_SUB_IDS=
MEDIA_STORE=True
DELETE_LINKS=False
VERIFY_TIMEOUT=0
LOGIN_PASS=

# Log Channels
LEECH_DUMP_CHAT=
LINKS_LOG_ID=
MIRROR_LOG_ID=

# Updates
UPSTREAM_REPO=
UPSTREAM_BRANCH=main
